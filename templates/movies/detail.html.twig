{% extends 'base.html.twig' %}

{% block title %}
    {{ movieData.title }} | Détails
{% endblock %}

{% block body %}

    <div class="movie-header" {% if movieData.backdrop_path %}style="background-image: url('{{ imgUrls.original ~ movieData.backdrop_path }}');"{% endif %}>
        <div class="container header-content">
            <div class="row">
                <div class="col-md-9 mx-auto text-center">
                    <h1 class="display-4 fw-bold">{{ movieData.title }}</h1>
                    <p class="lead mt-4">{{ movieData.overview|default('Synopsis non disponible.') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-4">
                {% include 'partials/_movie_details_aside.html.twig' %}
            </div>

            <div class="col-md-8 border-start ps-4">

                {% if movieData.video is not empty and movieData.video.key is defined and movieData.video.site == 'YouTube' %}
                    <div class="row justify-content-start mb-4">
                        <div class="col-12 col-lg-10">
                            <div class="ratio ratio-16x9 rounded shadow">
                                <iframe width="560" height="315"
                                        src="https://www.youtube.com/embed/{{ movieData.video.key }}"
                                        title="{{ movieData.video.name }}"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4">
                {% endif %}

                {% if movieData.casting is not empty %}

                    {% if movieData.casting.directors is not empty %}
                        <h2 class="h4 mb-3">Réalisateur(s)</h2>
                        <p>
                            {% for director in movieData.casting.directors %}
                                <a href="{{ path('person_detail', { id: director.id }) }}" class="d-block">
                                    <span class="badge bg-secondary me-2 p-2 fw-normal">{{ director.name }}</span>
                                </a>
                            {% endfor %}
                        </p>
                    {% endif %}

                    {% if movieData.casting.mainCast is not empty %}
                        <h2 class="h4 mt-4 mb-3">Casting</h2>
                        <div class="actor-grid-top-cast  d-flex flex-wrap justify-content-start">
                            {% for actor in movieData.casting.mainCast %}

                                <div class="actor-card-flex rounded-3">
                                    <a href="{{ path('person_detail', { id: actor.id }) }}" class="d-block">
                                        {% if actor.profile_path %}
                                            <img src="{{ imgUrls.small ~ actor.profile_path }}"
                                                 alt="{{ actor.name }}"
                                                 class="actor-profile shadow-sm">
                                        {% else %}
                                            <div class="actor-profile bg-dark d-flex align-items-center justify-content-center text-white-50 mx-auto">?</div>
                                        {% endif %}
                                        <strong class="actor-text-info">{{ actor.name }}</strong>

                                        <small class="actor-text-info text-muted" title="{{ actor.character }}">
                                            {{ actor.character|u.truncate(22, '…') }}
                                        </small>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="text-center mt-3 mb-4">
                            <a href="{{ path('movie_full_cast', { id: movieData.id }) }}"
                               class="btn btn-outline-secondary fw-bold">
                                Voir le casting complet
                            </a>
                        </div>
                    {% endif %}
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
