{% extends 'base.html.twig' %}

{% block title %}
    Casting et Équipe de {{ movieData.title }}
{% endblock %}

{% block body %}

    <div class="movie-header" {% if movieData.backdrop_path %}style="background-image: url('{{ imgUrls.original ~ movieData.backdrop_path }}');"{% endif %}>
        <div class="container header-content">
            <div class="row">
                <div class="col-md-9 mx-auto text-center">
                    <h1 class="display-4 fw-bold">Casting et Équipe</h1>
                    <p class="lead mt-2">{{ movieData.title }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-4">
                <div class="mb-4">
                    <a href="{{ path('movie_detail', {'id': movieData.id}) }}"
                       class="btn btn-outline-secondary w-100 fw-bold">
                        ← Retour aux détails
                    </a>
                </div>
                {% include 'partials/_movie_details_aside.html.twig' %}
            </div>

            <div class="col-md-8 border-start ps-4">
                {% if movieData.casting.directors is not empty %}
                    <h2 class="h4 mb-3">Réalisateur(s)</h2>
                    <div class="actor-grid-top-cast d-flex flex-wrap justify-content-start">
                        {% for director in movieData.casting.directors %}
                            <div class="actor-card-flex rounded-3">
                                <a href="{{ path('person_detail', { id: director.id }) }}" class="d-block">
                                {% if director.profile_path %}
                                    <img src="{{ imgUrls.small ~ director.profile_path }}"
                                         alt="{{ director.name }}"
                                         class="actor-profile shadow-sm">
                                {% else %}
                                    <div class="actor-profile bg-dark d-flex align-items-center justify-content-center text-white-50 mx-auto">?</div>
                                {% endif %}
                                <strong class="actor-text-info">{{ director.name }}</strong>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                <hr class="my-4">

                {% if movieData.casting.cast is not empty %}
                    <h2 class="h4 mt-4 mb-3">Casting</h2>
                    <div class="actor-grid-top-cast d-flex flex-wrap justify-content-start">
                        {% for actor in movieData.casting.cast|slice(0, 10) %}
                            <div class="actor-card-flex rounded-3">
                                <a href="{{ path('person_detail', { id: actor.id }) }}" class="d-block">
                                    {% if actor.profile_path %}
                                        <img src="{{ imgUrls.small ~ actor.profile_path }}"
                                             alt="{{ actor.name }}"
                                             class="actor-profile shadow-sm">
                                    {% else %}
                                        <div class="actor-profile bg-dark d-flex align-items-center justify-content-center text-white-50 mx-auto">?</div>
                                    {% endif %}
                                    <strong class="actor-text-info">{{ actor.name }}</strong>
                                    <small class="actor-text-info text-muted">{{ actor.character }}</small>
                                </a>
                            </div>
                        {% endfor %}
                    </div>

                    {% if movieData.casting.cast|length > 10 %}
                    <hr class="my-4">

                        <h2 class="h4 mt-4 mb-3">Liste Complète</h2>
                        <dl class="row">
                            {% for actor in movieData.casting.cast|slice(10) %}
                                <dt class="col-sm-6 text-truncate" title="{{ actor.name }}">
                                    <a href="{{ path('person_detail', { id: actor.id }) }}"
                                       class="d-block text-decoration-none link-primary fw-bold">
                                        {{ actor.name }}
                                    </a>
                                </dt>
                                <dd class="col-sm-6 text-muted text-truncate" title="{{ actor.character }}">{{ actor.character }}</dd>
                            {% endfor %}
                        </dl>
                    {% endif %}
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
