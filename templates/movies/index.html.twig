{% extends 'base.html.twig' %}
{% import 'partials/_movie_macros.html.twig' as movieMacros %}

{% block title %}Movies API{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2 class="mb-3">Tendances actuelles</h2>
        {{ movieMacros.movieCarousel(popularMovies, 'popular', imgUrls) }}

        <h2 class="mb-3">Top des critiques</h2>
        {{ movieMacros.movieCarousel(topRatedMovies, 'toprated', imgUrls) }}
    </div>

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/caroussel.js') }}"></script>
    {% endblock %}
{% endblock %}
