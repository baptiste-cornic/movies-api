{% extends 'base.html.twig' %}

{% block title %}Recherche "{{ query }}" - Movies API{% endblock %}

{% block body %}
    {% set currentSort = app.request.query.get('sort', 'relevance') %}
    {% set sortOptions = {
        'relevance': 'Pertinence',
        'date': 'Date',
        'rating': 'Note moyenne'
    } %}
    {% set baseParams = app.request.attributes.get('_route_params')|merge({'query': query}) %}

    <div class="container mt-4">

        {% if query %}
            <h1 class="mb-3 border-bottom pb-2">Résultats pour : "{{ query }}"</h1>
        {% else %}
            <h1 class="mb-4">Veuillez entrer un terme de recherche.</h1>
        {% endif %}

        {% if moviesData is not empty %}
            <div class="d-flex align-items-center justify-content-between mb-1 pb-2">
                <p class="lead text-muted">{{ moviesData|length }} film(s) trouvé(s).</p>
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Trier par :
                            <span class="fw-bold">
                                {{ sortOptions[currentSort] }}
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% for sortKey, sortLabel in sortOptions %}
                                <li>
                                    <a class="dropdown-item {% if currentSort == sortKey %}active{% endif %}"
                                       href="{{ path(app.request.attributes.get('_route'), baseParams|merge({'sort': sortKey})) }}">
                                        {{ sortLabel }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="list-group mb-5">
                {% for movie in moviesData %}
                    <a href="{{ path('movie_detail', { id: movie.id }) }}"
                       class="list-group-item list-group-item-action d-flex p-0 mb-3 shadow-sm border-0 rounded">
                        <div class="d-flex w-100">

                            {% if movie.poster_path %}
                                <img src="{{ imgUrls.medium ~ movie.poster_path }}"
                                    alt="{{ movie.title }}"
                                    class="flex-shrink-0 me-3 rounded-start search-poster-img">
                            {% else %}
                                <div class="d-flex align-items-center justify-content-center text-center me-3 rounded-start bg-secondary text-white search-poster-placeholder">
                                    <small>N/A</small>
                                </div>
                            {% endif %}

                            <div class="p-3 d-flex flex-column justify-content-start flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h5 class="mb-0 text-primary">{{ movie.title }}</h5>
                                    {% set year = movie.release_date ? movie.release_date|date('Y') : 'N/A' %}
                                    {% if year != 'N/A' %}
                                        <span class="badge bg-primary text-white fw-bold ms-3 p-2 flex-shrink-0">
                                            {{ year }}
                                        </span>
                                    {% endif %}
                                </div>

                                {% if movie.vote_average is defined and movie.vote_average > 0 %}
                                    <p class="mb-1 text-dark small">
                                        <i class="fas fa-star text-warning me-1"></i>
                                        <span class="fw-bold">{{ movie.vote_average|round(1) }}</span>
                                    </p>
                                {% endif %}

                                {% if movie.overview %}
                                    <p class="mb-0 text-muted small">
                                        {{ movie.overview|length > 400 ? movie.overview|slice(0, 400) ~ '...' : movie.overview }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

        {% elseif query %}
            <div class="alert alert-warning mt-4" role="alert">
                Désolé, aucun film trouvé pour la recherche "{{ query }}".
            </div>
        {% endif %}

    </div>
{% endblock %}
